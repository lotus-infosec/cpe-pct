{
  "name": "cpe-pct",
  "version": "1.0.0",
  "private": true,
  "description": "CPE Personal Certification Tracker. Single-owner continuing-education and certification-maintenance tracker; one codebase for Cloudflare Workers and Docker Compose.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p web/tsconfig.json && tsc -p test/core/tsconfig.json && tsc -p test/node/tsconfig.json && tsc -p test/web/tsconfig.json && tsc -p test/workers/tsconfig.json",
    "prepare": "node scripts/prepare.mjs",
    "dev:node": "tsx watch src/entry.node.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:cf": "wrangler dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild src/entry.node.ts scripts/migrate.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs --entry-names=[name]",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-migrations.ts",
    "cf:types": "wrangler types",
    "deploy": "npm run build:web && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "release": "gitleaks detect --redact --no-banner && npm run deploy",
    "catalog:check": "tsx scripts/compile-catalog.ts",
    "catalog:compile": "tsx scripts/compile-catalog.ts --write",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "verify-restore": "tsx scripts/verify-restore.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "@libsql/client": "0.18.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.12",
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "lefthook@2.1.12": true,
    "workerd@1.20260911.1": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
