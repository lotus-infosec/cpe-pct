// assets.directory points at a path that does NOT exist in the repository, exactly as the real
// config does: web/dist is a build output and is gitignored. Everything else is minimal.
{
  "name": "cpe-pct-bt-g-assets-missing-dir",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
