// Everything the real config has. Expected to reproduce the failure.
{
  "name": "cpe-pct-bt-b-full",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cpe-pct-button-test",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "cpe-pct-button-test-evidence"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": false
  }
}
